              "raw": "{\n  \"purpose\": \"EQUIPMENT\",\n  \"amount\": \"1200000\",\n  \"term_months\": 24,\n  \"inn\": \"002000010193\"\n}",
              "options": {
                "raw": {
                  "language": "json"
