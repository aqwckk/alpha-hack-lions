# Пример переменных окружения. Docker Compose работает и без .env: ниже те же безопасные демо-значения,
# что заданы по умолчанию в docker-compose.yml. Скопируйте в .env и меняйте только нужное.
# Все пароли ниже публичные и подходят только для локального демо на синтетических данных.

# --- режим -------------------------------------------------------------------------------------
APP_ENV=demo
# DEMO_MODE=true: код подписания возвращается в ответе API и показывается в интерфейсе (в прототипе нет SMS),
# доступны демо-эндпоинты управления симулятором внешних систем (/api/v1/demo/*)
DEMO_MODE=true
LOG_LEVEL=INFO

# --- PostgreSQL 17 ------------------------------------------------------------------------------
POSTGRES_DB=credit
# владелец схемы: применяет миграции (сервис migrate)
POSTGRES_USER=credit_owner
POSTGRES_PASSWORD=credit_owner_demo
# роль приложения: только чтение и запись данных, без DDL (api и worker)
APP_DB_USER=credit_app
APP_DB_PASSWORD=credit_app_demo

# --- аутентификация ----------------------------------------------------------------------------
# Пусто: ключ подписи JWT генерируется один раз и хранится в БД (общий для всех реплик api).
# Для стенда задайте случайную строку не короче 32 символов.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=1800
# true за HTTPS: refresh-cookie с флагом Secure и заголовок HSTS
REFRESH_COOKIE_SECURE=false
# origin веб-интерфейса (nginx) и dev-сервера Vite
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- порты на хосте ------------------------------------------------------------------------------
# api публикуется только на 127.0.0.1 (для e2e-скрипта, Postman, Swagger UI /api/docs)
API_PORT=8000

# --- конфиги скоринга и политики (analytics/artifacts) -----------------------------------------
# api и worker отказываются работать с файлом другой версии или с другим хешем
SCORECARD_EXPECTED_VERSION=scorecard-2026.10-v1
SCORECARD_EXPECTED_SHA256=86c9d5da393b5e9b111ffad51c45b0fd10d0d282d9e631bbb46efa8f0bdc78a5
POLICY_EXPECTED_VERSION=policy-2026.10-v1
POLICY_EXPECTED_SHA256=e42df7693f53bebb07cd94ef366e0ae2a4db875a6e93ec8b6a9e39e10fc019a7
# импорт синтетической истории (420 заявок, 11 648 событий) для экрана метрик
SEED_HISTORY=true

# --- внешние системы (integrations-mock) --------------------------------------------------------
# необязательный внутренний ключ между api/worker и симулятором (пусто: проверка выключена)
INTEGRATIONS_API_KEY=
# таймаут одного запроса к источнику, быстрые повторы (до 3 попыток) и расписание отложенных повторов
SOURCE_TIMEOUT_SECONDS=5
SOURCE_FAST_RETRY_DELAYS=1,2,4
ENRICHMENT_RETRY_SCHEDULE=30,60,120,300,600
# задержка ответов симулятора и длительность "таймаута" (больше SOURCE_TIMEOUT_SECONDS)
MOCK_DELAY_MS_MIN=200
MOCK_DELAY_MS_MAX=800
MOCK_TIMEOUT_SLEEP_SECONDS=6

# --- сроки процесса (пусто: значения из policy.v1.json, раздел process) -------------------------
# Для демонстрации истечения можно сократить, например OFFER_TTL_SECONDS=600 (10 минут).
OFFER_TTL_SECONDS=
INFO_REQUEST_TTL_SECONDS=
DRAFT_TTL_SECONDS=
MANUAL_REVIEW_SLA_SECONDS=
SIGNING_CODE_TTL_SECONDS=300
# период планировщика таймеров воркера (не реже 15 секунд по спецификации)
TIMER_INTERVAL_SECONDS=5
# число процессов воркера (очередь на PostgreSQL безопасна для нескольких воркеров)
WORKER_REPLICAS=1

# --- ИИ (необязательно, профиль compose "ai") ----------------------------------------------------
# docker compose --profile ai up -d   и   OLLAMA_URL=http://ollama:11434
# Пусто: резюме для андеррайтера и пояснение для клиента строятся детерминированными шаблонами.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:1.5b-instruct
