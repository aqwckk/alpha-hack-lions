    "rate_percent": "строка, проценты годовых, 2 знака (23.50 = 23,5% годовых)",
    "rounding": "Decimal prec=28; деньги ROUND_HALF_UP до 0.01; доли ROUND_HALF_UP до 0.0001; суммы вариантов вниз до amount_rounding"
  },
